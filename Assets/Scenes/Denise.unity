      objectReference: {fileID: -8142007118353831715, guid: 6c78505d3d232fc4a81712bc3bf54339, type: 3}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: Tag
      value: Letter
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: npcHints
      value: Look for a big purple spirit along the pathway.
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: indicator
      value: 
      objectReference: {fileID: 109710702}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: parcelHints
      value: Look for a purple letter on top of a green brick roof with a green..
        tall spirit.
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: assignedNPC.npcID
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: parcelData.isActiveQuest
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: parcelStoryDialog.lines.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[0]'
      value: '"Ahh.. so this is what I was missing.. A letter from my love, telling
        me she forgives me."'
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[1]'
      value: '"I remember it now.. We had a big quarrel before the accident over
        the phone.."'
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[2]'
      value: '"She was always worried about me riding that bike. I knew it scared
        her, but I never listened."'
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[3]'
      value: '"I thought I had all the time in the world to prove to her that I''d
        be okay."'
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[4]'
      value: '"I guess I do not have the chance now. But she forgave me, even after
        everything.."'
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[5]'
      value: '"I can go now.. Thank you for bringing me home."'
      objectReference: {fileID: 0}
    - target: {fileID: 5279036025520876059, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: m_Enabled
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5279036025520876059, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: sourceAsset
      value: 
      objectReference: {fileID: 9197481963319205126, guid: 06bb701936804a440a6d1e1fc1e7ed45, type: 3}
    - target: {fileID: 5279036025520876059, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
