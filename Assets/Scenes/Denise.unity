    - target: {fileID: 1821601152365033286, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: m_Name
      value: Blue Parcel
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: Tag
      value: Parcel
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: npcHints
      value: Look for a blue spirit standing by the door of a 2 storey purple house.
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: indicator
      value: 
      objectReference: {fileID: 2096373695}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: parcelHints
      value: Look for a purple parcel on top of a purple roof
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: parcelStoryDialog.lines.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[0]'
      value: '"Oh.. is a parcel from my parents.."'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[1]'
      value: '"They had sent me a plush toy, letter and a photo album.."'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[2]'
      value: '"The letter written how much they missed me and loved me.. I.. I didn''t
        know I would have cause them so much pain.."'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[3]'
      value: '"I thought dying was a better choice.."'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[4]'
      value: '"They loved me so much.. so so much.."'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[5]'
      value: '"Despite everything, I was loved afterall.."'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[6]'
      value: '"Thank you for the parcel.."'
      objectReference: {fileID: 0}
    - target: {fileID: 8461658817605078293, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: m_Enabled
      value: 1
      objectReference: {fileID: 0}
