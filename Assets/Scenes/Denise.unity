      propertyPath: m_Enabled
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1799197529801390035, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: sourceAsset
      value: 
      objectReference: {fileID: 9197481963319205126, guid: 1b00016b5545f784ea2db97ffe922e82, type: 3}
    - target: {fileID: 3330070731334641965, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: m_Sprite
      value: 
      objectReference: {fileID: 6773045192503259582, guid: b925d282d95bb6a429914c8e8fcfd9dd, type: 3}
    - target: {fileID: 5539784541261502080, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: m_SpriteTilingProperty.oldSize.x
      value: 1.6
      objectReference: {fileID: 0}
    - target: {fileID: 5539784541261502080, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: m_SpriteTilingProperty.oldSize.y
      value: 2.43
      objectReference: {fileID: 0}
    - target: {fileID: 5683550773758392088, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: showButtonAfterDialog
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5683550773758392088, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: dialog.lines.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 5683550773758392088, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: 'dialog.lines.Array.data[0]'
      value: '"Hey.. You can see me?"'
      objectReference: {fileID: 0}
    - target: {fileID: 5683550773758392088, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: 'dialog.lines.Array.data[1]'
      value: '"It''s been so long since anyone saw me..""'
      objectReference: {fileID: 0}
    - target: {fileID: 5683550773758392088, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: 'dialog.lines.Array.data[2]'
      value: '"I can''t remember anything but the headlights, so bright shining into
        my eyes. The sound of metal crumpling.. the weightlessness before the fall"'
      objectReference: {fileID: 0}
    - target: {fileID: 5683550773758392088, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: 'dialog.lines.Array.data[3]'
      value: '"I think I heared voices, distinct, fading.. Someone is crying.. I
        think someone is calling my name.."'
      objectReference: {fileID: 0}
    - target: {fileID: 5683550773758392088, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: 'dialog.lines.Array.data[4]'
      value: '"I can''t leave.. I feel like something is missing.. But I don''t know
        what it is.."'
      objectReference: {fileID: 0}
    - target: {fileID: 6294382644697623487, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: m_LocalPosition.x
      value: 4.66
      objectReference: {fileID: 0}
    - target: {fileID: 6294382644697623487, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: m_LocalPosition.y
      value: -2.36
      objectReference: {fileID: 0}
    - target: {fileID: 6294382644697623487, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: m_LocalPosition.z
