    - target: {fileID: 1821601152365033286, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: m_Name
      value: Yellow Parcel
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: Tag
      value: Parcel
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: npcHints
      value: Look for a small kid by himself in front of a purple house.
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: indicator
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: parcelHints
      value: Lok for a yellow parcel on top of green brick roof with many chairs
        next to it.
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: assignedNPC.npcID
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: parcelStoryDialog.lines.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[0]'
      value: '"OMG ITS BEAR BEAR!"'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[1]'
      value: '"This was.. this was from my parents!! They made it for me !!!"'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[2]'
      value: '"All I remember was holding onto bear bear while playing by the swimming
        pool.."'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[3]'
      value: '"Daddy and mommy couldn''t save me.. I saw them crying while holding
        onto my lifeless body.."'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[4]'
      value: '"I made them sad.. I thought they would not like me anymore since I
        made them sad"'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[5]'
      value: '"But I guess not.. They sent me bear bear!!"'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[6]'
      value: '"Thank you so much Santa!!!"'
      objectReference: {fileID: 0}
    - target: {fileID: 8403121692980914618, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: m_Sprite
      value: 
      objectReference: {fileID: 6813846094819246631, guid: 6c78505d3d232fc4a81712bc3bf54339, type: 3}
    - target: {fileID: 8461658817605078293, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
