      propertyPath: showButtonAfterDialog
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5683550773758392088, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: dialog.lines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5683550773758392088, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: 'dialog.lines.Array.data[0]'
      value: '"Hey.. You can see me?"'
      objectReference: {fileID: 0}
    - target: {fileID: 5683550773758392088, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: 'dialog.lines.Array.data[1]'
      value: '"It''s been so long since anyone saw me..""'
      objectReference: {fileID: 0}
    - target: {fileID: 5683550773758392088, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: 'dialog.lines.Array.data[2]'
      value: '"Will you play a puzzle with me?"'
      objectReference: {fileID: 0}
    - target: {fileID: 5683550773758392088, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: 'dialog.lines.Array.data[3]'
      value: '"I think I heared voices, distinct, fading.. Someone is crying.. I
        think someone is calling my name.."'
      objectReference: {fileID: 0}
    - target: {fileID: 5683550773758392088, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: 'dialog.lines.Array.data[4]'
      value: '"I can''t leave.. I feel like something is missing.. But I don''t know
        what it is.."'
      objectReference: {fileID: 0}
    - target: {fileID: 6294382644697623487, guid: cda753b2628ca4242bc2c8e1de23ef1f, type: 3}
      propertyPath: m_LocalPosition.x
      value: 4.66
