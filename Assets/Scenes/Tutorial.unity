    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: npcHints
      value: Look for a red angry spirit.
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: parcelHints
      value: Look for a red parcel on top of a single building
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: assignedNPC.npcID
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: parcelStoryDialog.lines.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[0]'
      value: '"I didn''t get to have it.. not once..""'
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[1]'
      value: '"I was always told no McDonald''s, my favourite.. always just out of
        my reach because of my illness..""'
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[2]'
      value: '"My parents must have sent them to me.""'
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[3]'
      value: '"I miss them so much.."'
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[4]'
      value: '"This feels so strange.. but so good."'
      objectReference: {fileID: 0}
    - target: {fileID: 3885692998836085359, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[5]'
      value: '"I can finally have it.. Thank you so much!"'
      objectReference: {fileID: 0}
    - target: {fileID: 5279036025520876059, guid: 085ab47fc3ae121428a1ce8862669261, type: 3}
      propertyPath: m_Enabled
      value: 1
      objectReference: {fileID: 0}
