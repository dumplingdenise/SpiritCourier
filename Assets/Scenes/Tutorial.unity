      objectReference: {fileID: 0}
    - target: {fileID: 1821601152365033286, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: m_Name
      value: Green Parcel
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: Tag
      value: Parcel
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: npcHints
      value: Look for a granny spirit.
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: parcelHints
      value: Look for a green parcel on top of a green roof
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: assignedNPC.npcID
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: parcelStoryDialog.lines.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[0]'
      value: '"My sweet children.. My little darlings.. Oh, how I worried about leaving
        you all behind.."'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[1]'
      value: '"I wasn''t afraid to go.. I was just afraid of what I''d leave behind..
        My greatest treasure, my loves"'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[2]'
      value: '"But look at you all, Strong, happy, together.."'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[3]'
      value: '"My lovely childrenm abd my sweet grandchildren, all grown up.. "'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[4]'
      value: '"I see it all now, they''ll carry me in their hearts even when I''m
        gone, they''ll be okay.. And that means I can go peacefully."'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[5]'
      value: '"Thank you dear, for bringing this to me. You didn''t just bring me
        a parcel... you brought me a lifetime of life, all wrapped up in these pages.
        "'
      objectReference: {fileID: 0}
    - target: {fileID: 5176107732845650057, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: 'parcelStoryDialog.lines.Array.data[6]'
      value: '"This is exactly what I needed to see before I go."'
      objectReference: {fileID: 0}
    - target: {fileID: 8403121692980914618, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: m_Sprite
      value: 
      objectReference: {fileID: 5541013498141950252, guid: 6c78505d3d232fc4a81712bc3bf54339, type: 3}
    - target: {fileID: 8461658817605078293, guid: 0127d05d12d2a4441b9e7e08bf15fa7b, type: 3}
      propertyPath: m_Enabled
      value: 1
      objectReference: {fileID: 0}
