    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "[Died in an Accident]\nI thought she\u2019d never forgive me. She begged
    me to stop, said the road was too dangerous, but I wouldn\u2019t listen. The
    speed, the freedom\u2014it was everything to me. Until it wasn\u2019t."
